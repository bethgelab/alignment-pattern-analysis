Bootstrap: docker
From: nvidia/cuda:12.2.2-cudnn8-devel-ubuntu22.04

# Build from the repository root, so %files finds the lockfile:
#   singularity build --fakeroot singularity/multitasking.sif singularity/container.def
#
# The Python environment is uv.lock, installed with --no-install-project: the image
# holds the dependencies only. Jobs run the copy of multitasking/ that the launchers
# put in each job directory (tasks/*/run.sh checks this).


%files
    pyproject.toml /opt/env/pyproject.toml
    uv.lock /opt/env/uv.lock


%environment
    export PATH=/opt/venv/bin:$PATH
    export VIRTUAL_ENV=/opt/venv


%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -yq --no-install-recommends \
        bash-completion \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        ffmpeg \
        git \
        git-lfs \
        htop \
        less \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        locales \
        openssh-client \
        unzip \
        vim \
        wget \
        xz-utils \
        zlib1g-dev
    apt-get clean && rm -rf /var/lib/apt/lists/*

    locale-gen "en_US.UTF-8"

    git lfs install


    # --- Dropbear ---
    export DROPBEAR_VERSION="2025.87"
    curl -O https://matt.ucc.asn.au/dropbear/releases/dropbear-${DROPBEAR_VERSION}.tar.bz2
    tar -xjf dropbear-${DROPBEAR_VERSION}.tar.bz2
    cd dropbear-${DROPBEAR_VERSION}
    ./configure
    make
    make install
    cd ..
    rm -rf dropbear-${DROPBEAR_VERSION}
    rm dropbear-${DROPBEAR_VERSION}.tar.bz2


    # --- uv and Python ---
    export UV_VERSION="0.11.32"
    curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

    export UV_PYTHON_INSTALL_DIR=/opt/python
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export UV_LINK_MODE=copy
    export UV_NO_CACHE=1
    export UV_COMPILE_BYTECODE=1
    export UV_PYTHON_PREFERENCE=only-managed
    uv python install 3.12


    # --- Locked dependencies ---
    cd /opt/env
    uv sync --frozen --no-install-project --extra all --group dev


    # --- mmcv and mmaction2 ---
    # Neither is in the lock: mmcv compiles CUDA ops against the installed torch,
    # and mmaction2 needs an editable install. Their runtime dependencies are the
    # `mmaction2` extra above, hence --no-deps.
    #
    # Building MMCV may take some time. Be patient.
    MMCV_WITH_OPS=1 FORCE_CUDA="1" TORCH_CUDA_ARCH_LIST="Volta;Turing;Ampere" \
        uv pip install --python /opt/venv/bin/python --no-build-isolation --no-deps \
        "mmcv @ git+https://github.com/open-mmlab/mmcv.git@v2.1.0"

    # The editable install keeps the base config files and the DRN sources, which
    # are not copied to site-packages; see
    # https://github.com/open-mmlab/mmaction2/issues/2714
    cd /opt
    git clone https://github.com/open-mmlab/mmaction2.git
    cd mmaction2
    git checkout v1.2.0
    uv pip install --python /opt/venv/bin/python --no-build-isolation --no-deps -e .
